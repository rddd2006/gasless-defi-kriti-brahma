# Environment Configuration Example
# Copy this to .env and fill in your actual values

# Sepolia Network RPC URL
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Private Key for contract deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Deployed contract address (after running forge script)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Node environmentSEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/_i1qBNG3YrrhqVuOaGKTy
BLS_PRIVATE_KEY=71xx
ETHERSCAN_API_KEY=SZx
PRIVATE_KEY=0x88a83x
CONTRACT_ADDRESS=0x445x
VITE_CONTRACT_ADDRESS=0x445x
CORS_ALLOWED_ORIGIN=http://localhost:8080
VITE_BACKEND_URL=http://localhost:4000


# Frontend configuration


# Optional: Etherscan API for verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
